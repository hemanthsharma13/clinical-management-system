PORT=3000
NODE_ENV=development
# Use MONGODB_URI=memory to boot an ephemeral database without a MongoDB install.
# For Docker Compose on a local machine, this is the default authenticated Mongo connection.
MONGODB_URI=mongodb://clinicadmin:clinicpassword@localhost:27017/clinic?authSource=admin
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_SECONDS=28800
# Set KAFKA_ENABLED=false only for UI development without a broker.
# Docker Compose and any real run should leave this true.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=clinic-appointment-system
KAFKA_APPOINTMENT_TOPIC=appointment.booked
KAFKA_NOTIFICATION_GROUP=notification-service
KAFKA_IDEMPOTENT=true
CLINIC_TIMEZONE=Asia/Kolkata
OUTBOX_POLL_MS=5000
# all | api | worker. Local development uses all.
PROCESS_ROLE=all
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
RECEPTIONIST_PASSWORD=receptionist123
ADMIN_PASSWORD=admin123

# Optional overrides for Docker Compose local development
# MONGO_INITDB_ROOT_USERNAME=clinicadmin
# MONGO_INITDB_ROOT_PASSWORD=clinicpassword
# MONGO_INITDB_DATABASE=clinic
# KAFKA_BROKERS=kafka:29092
